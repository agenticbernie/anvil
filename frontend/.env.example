# Required: set this to the API origin; OpenAPI currently has no `servers` entry.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Clerk Dashboard -> Configure -> Developers -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/cases
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/cases

# Optional local development tenant bypass. Must be a valid Anvil tenant UUID.
NEXT_PUBLIC_DEV_TENANT_ID=

# Supabase project settings -> API. The publishable/anon key is safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects may still expose the anon key under this name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
