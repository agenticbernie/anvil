# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
API_PREFIX=v1
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3001
REQUEST_ID_HEADER=x-request-id

# Supabase Auth and PostgreSQL
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
# Clerk Dashboard -> API keys. Backend only; never expose as NEXT_PUBLIC_*.
CLERK_SECRET_KEY=
# Clerk Dashboard -> Webhooks -> endpoint signing secret (whsec_...).
CLERK_WEBHOOK_SECRET=
# Supabase Dashboard -> Project Settings -> Database -> Connection string:
# copy the Session pooler URI (IPv4), not the db.<project-ref>.supabase.co direct host.
# Format: postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:5432/postgres
# Use the host and credentials supplied by the Dashboard; URL-encode the password if needed.
# Configure the same DATABASE_URL on both anvil-web and anvil-worker in Render.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Upstash Redis TCP credentials for BullMQ. Use the TCP tab in Upstash Connect,
# not the HTTPS REST URL/token. URL form: rediss://<host>:6379.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
WORKER_CONCURRENCY=1

# Cloudflare R2
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Application-level PII encryption key: base64-encoded 32-byte key.
# Generate with `openssl rand -base64 32`; supply through a secret manager.
# Required in production. Keep this root key out of source control and client responses.
PII_ENCRYPTION_KEY_BASE64=
PII_ENCRYPTION_KEY_VERSION=v1

# Web API HMAC key for idempotency request fingerprints. Generate with `openssl rand -base64 32`.
# Keep previous keys here for at least the 24-hour idempotency replay window during rotation.
IDEMPOTENCY_HASH_KEY_BASE64=
IDEMPOTENCY_HASH_KEY_PREVIOUS_BASE64=

# LLM API adapter settings. Only external API calls are permitted.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_REQUEST_TIMEOUT_MS=30000

# Upload and observability limits
MAX_UPLOAD_BYTES=52428800
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_HOST=
