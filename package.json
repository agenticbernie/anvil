{
  "name": "anvil",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Evidence-first underwriting platform foundation",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run start:web",
    "start:web": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "openapi:generate": "npm run build && node dist/openapi/generate-openapi.js",
    "idempotency-cache:backfill": "npm run build && node dist/scripts/backfill-idempotency-response-cache.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand && node --experimental-strip-types --test test/*.test.mjs",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand src",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --testPathPattern='(integration|phase3-outbox-worker)\\.spec\\.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "bullmq": "^6.5.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "18.0.9",
    "ioredis": "^6.0.0",
    "joi": "18.3.1",
    "jose": "^6.2.14",
    "nestjs-pino": "5.3.1",
    "passport": "^0.7.0",
    "passport-custom": "^1.2.1",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "24.19.2",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.0"
  }
}
